use python sqlite3
use python time

start = time.time()

conn = sqlite3.connect("test.db")
c = conn.cursor()
c.execute("DROP TABLE IF EXISTS users")
c.execute("CREATE TABLE users (id INTEGER, name TEXT)")

repeat 100 times:
    c.execute("INSERT INTO users VALUES (?, ?)", [it, "User " + str(it)])

c.execute("SELECT * FROM users")
rows = c.fetchall()
conn.commit()
conn.close()

end = time.time()
show end - start
