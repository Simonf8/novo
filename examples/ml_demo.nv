use math
use python numpy as np
use python sklearn.linear_model as lm

# ==============================================================
# 1. PURE NATIVE NOVO: Gradient Descent Linear Regression
# ==============================================================
show "--- 1. Pure Native Novo Linear Regression ---"

# Feature: House area (in 100 sq ft) -> Target: Price (in $1,000s)
# y = 2.5 * x + 50 (with small variation)
x_data = [10.0, 15.0, 20.0, 25.0, 30.0, 35.0, 40.0]
y_data = [75.0, 88.0, 102.0, 114.0, 126.0, 137.0, 152.0]
n = x_data.length()

# Initialize parameters
weight = 0.0
bias = 0.0
learning_rate = 0.001
epochs = 5000

# Training Loop using natural control flow
repeat epochs times:
    w_grad = 0.0
    b_grad = 0.0
    
    i = 0
    while i < n:
        x_val = x_data[i]
        y_val = y_data[i]
        
        prediction = (weight * x_val) + bias
        error = prediction - y_val
        
        w_grad = w_grad + (error * x_val)
        b_grad = b_grad + error
        i = i + 1
        
    weight = weight - (learning_rate * (2.0 * w_grad / float(n)))
    bias = bias - (learning_rate * (2.0 * b_grad / float(n)))

show "Trained Model Parameters:"
show "Weight (slope): " + str(weight)
show "Bias (intercept): " + str(bias)

# Inference on unseen house: 28.0 (2,800 sq ft)
test_area = 28.0
predicted_price = (weight * test_area) + bias
show "Predicted Price for 2,800 sq ft house: $" + str(predicted_price) + "k"

# ==============================================================
# 2. ACCELERATED ML VIA PYTHON INTEROP: Logistic Regression
# ==============================================================
show ""
show "--- 2. Python-Accelerated Logistic Regression ---"

# Features: [Hours Studied, Attendance Rate %]
# Labels: Passed (1) or Failed (0)
X = np.array([
    [1.0, 40.0],
    [2.0, 50.0],
    [3.0, 55.0],
    [4.0, 70.0],
    [6.0, 80.0],
    [7.0, 85.0],
    [8.0, 90.0],
    [9.0, 95.0]
])
y = np.array([0, 0, 0, 0, 1, 1, 1, 1])

# Train model directly through interop
clf = lm.LogisticRegression()
clf.fit(X, y)

# Predict new student outcomes:
# Student A: 2 hours studied, 60% attendance
# Student B: 8 hours studied, 88% attendance
test_students = np.array([
    [2.0, 60.0],
    [8.0, 88.0]
])

predictions = clf.predict(test_students)
show "Predictions (0 = Fail, 1 = Pass):"
show predictions.tolist()
show "Student A: Failed, Student B: Passed"
show "Machine Learning pipeline completed successfully in Novo."
