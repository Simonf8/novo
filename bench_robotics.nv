use python time
use python random

start = time.time()
readings = []
repeat 10 times:
    val = random.random() * 100
    readings = readings + [val]
    time.sleep(0.01)

avg = readings average item
max_val = readings max item

show "Sensor Readings Average:"
show avg
show "Max Peak:"
show max_val

end = time.time()
show end - start
