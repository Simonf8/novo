# Comparisons with NaN are false, following IEEE 754.
nan = 0.0 * 1e400
show nan < 1.0, nan > 1.0, nan <= nan, 1 >= nan, nan == nan

# Booleans returned by helpers display correctly next to other values.
table = {"a": 1}
words = ["b"]
found = table.has("x")
show found, words[0]

# `max` and `min` keep the first value unless another is strictly beyond it.
show max(1.0, nan), max(nan, 1.0), min(2.0, nan, 1.0)
