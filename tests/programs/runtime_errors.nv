function risky(n):
    if n > 2:
        fail(f"too big: {n}")
    return n

try:
    show risky(1)
    show risky(5)
catch e:
    show "caught:", e

try:
    xs = [1, 2]
    show xs[5]
catch e:
    show e

try:
    show 9223372036854775807 + 1
catch e:
    show e

try:
    m = {"a": 1}
    show m["b"]
catch e:
    show e

try:
    assert_eq(1 + 1, 3, "math")
catch e:
    show e
