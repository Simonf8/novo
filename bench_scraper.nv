use python urllib.request as urllib

use python time
start = time.time()

url = "https://example.com"
html = get url
title_parts = html.split("<title>")
if title_parts.length() > 1:
    title = title_parts[1].split("</title>")[0]
    show "Title is:"
    show title
otherwise:
    show "No title found"

end = time.time()
show end - start
