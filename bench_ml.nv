use python numpy as np
use python sklearn.linear_model as lm
use python time

start = time.time()
X = np.array([[1, 2], [2, 3], [3, 4], [4, 5]])
y = np.array([0, 0, 1, 1])

model = lm.LogisticRegression()
model.fit(X, y)

test_data = np.array([[1.5, 2.5], [3.5, 4.5]])
predictions = model.predict(test_data)
end = time.time()
show end - start
