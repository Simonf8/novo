use python time
use python json

start_time = time.time()
show "Fetching user data in parallel..."

results = [
    get "https://jsonplaceholder.typicode.com/users/1",
    get "https://jsonplaceholder.typicode.com/users/2",
    get "https://jsonplaceholder.typicode.com/users/3"
] together

show "Parsing JSON..."
users = results select json.loads(item)
names = users select item.name

end_time = time.time()
elapsed = end_time - start_time

show "Fetched Users:"
show names
show "Elapsed time:"
show elapsed
