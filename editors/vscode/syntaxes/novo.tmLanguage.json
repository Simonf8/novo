{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Novo",
  "scopeName": "source.novo",
  "patterns": [
    { "include": "#comment" },
    { "include": "#fstring" },
    { "include": "#string" },
    { "include": "#declaration" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#number" },
    { "include": "#type" },
    { "include": "#call" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": { "name": "comment.line.number-sign.novo", "match": "#.*$" },
    "string": {
      "patterns": [
        { "name": "string.quoted.double.novo", "begin": "\"", "end": "\"", "patterns": [{ "include": "#escape" }] },
        { "name": "string.quoted.single.novo", "begin": "'", "end": "'", "patterns": [{ "include": "#escape" }] }
      ]
    },
    "fstring": {
      "patterns": [
        {
          "name": "string.interpolated.novo",
          "begin": "f(\")",
          "end": "\"",
          "beginCaptures": { "0": { "name": "storage.type.string.novo" } },
          "patterns": [{ "include": "#escape" }, { "include": "#interpolation" }]
        },
        {
          "name": "string.interpolated.novo",
          "begin": "f(')",
          "end": "'",
          "beginCaptures": { "0": { "name": "storage.type.string.novo" } },
          "patterns": [{ "include": "#escape" }, { "include": "#interpolation" }]
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.novo",
      "begin": "\\{",
      "end": "(:[^}]*)?\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.novo" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.novo" } },
      "patterns": [{ "include": "$self" }]
    },
    "escape": { "name": "constant.character.escape.novo", "match": "\\\\(u\\{[0-9a-fA-F]+\\}|.)" },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(function|task)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.function.novo" }, "2": { "name": "entity.name.function.novo" } }
        },
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.class.novo" }, "2": { "name": "entity.name.type.class.novo" } }
        }
      ]
    },
    "keyword": {
      "patterns": [
        { "name": "keyword.control.novo", "match": "\\b(if|otherwise|else|repeat|times|for|in|while|return|break|continue|pass|try|catch|together|await|run|parallel)\\b" },
        { "name": "keyword.control.import.novo", "match": "\\b(use|python|as)\\b" },
        { "name": "keyword.operator.logical.novo", "match": "\\b(and|or|not)\\b" },
        { "name": "keyword.other.query.novo", "match": "\\b(select|where|sum|average|min|max)\\b(?!\\s*\\()" },
        { "name": "keyword.other.show.novo", "match": "\\bshow\\b" },
        { "name": "variable.language.novo", "match": "\\b(self|it)\\b" }
      ]
    },
    "constant": { "name": "constant.language.novo", "match": "\\b(true|false|none)\\b" },
    "number": {
      "patterns": [
        { "name": "constant.numeric.float.novo", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.float.novo", "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9]+\\b" },
        { "name": "constant.numeric.integer.novo", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "type": { "name": "support.type.novo", "match": "\\b(Int|Float|Bool|String|List|Map|Tuple|Tensor|Optimizer|Task|Any|None)\\b" },
    "call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.novo" } }
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.arrow.novo", "match": "->|=>" },
        { "name": "keyword.operator.comparison.novo", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.assignment.novo", "match": "\\+=|-=|\\*=|/=|=" },
        { "name": "keyword.operator.arithmetic.novo", "match": "\\*\\*|//|[-+*/%@]" }
      ]
    }
  }
}
