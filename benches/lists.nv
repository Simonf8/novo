# Numeric list work: a prime sieve, prefix sums and a dot product.
n = 2000000
sieve: List[Bool] = range(n + 1) select true
sieve[0] = false
sieve[1] = false
i = 2
while i * i <= n:
    if sieve[i]:
        j = i * i
        while j <= n:
            sieve[j] = false
            j += i
    i += 1
primes = 0
for flag in sieve:
    if flag:
        primes += 1

prefix: List[Int] = range(n) select 0
for k in range(1, n):
    prefix[k] = prefix[k - 1] + k % 7

xs: List[Float] = range(n) select float(it) * 0.5
ys: List[Float] = range(n) select 1.0 / (float(it) + 1.0)
dot = 0.0
repeat 5 times:
    for k in range(n):
        dot += xs[k] * ys[k]
show primes, prefix[n - 1], round(dot)
